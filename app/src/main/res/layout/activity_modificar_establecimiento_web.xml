<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/mainLayoutModificarEstablecimientoWeb"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_app">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Modificar Establecimiento"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/text_black"
            android:layout_marginBottom="16dp" />

        <Spinner
            android:id="@+id/spinnerEstablecimientos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <Button
            android:id="@+id/btnRecargarEstablecimientos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Recargar establecimientos"
            android:layout_marginTop="12dp" />

        <EditText
            android:id="@+id/edtIdEstablecimiento"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="ID del establecimiento"
            android:inputType="number"
            android:layout_marginTop="14dp" />

        <EditText
            android:id="@+id/edtNombreEstablecimiento"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Nombre"
            android:layout_marginTop="10dp" />

        <EditText
            android:id="@+id/edtTelefonoEstablecimiento"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Teléfono"
            android:inputType="phone"
            android:layout_marginTop="10dp" />

        <EditText
            android:id="@+id/edtDireccionEstablecimiento"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Dirección"
            android:layout_marginTop="10dp" />

        <Button
            android:id="@+id/btnModificarEstablecimiento"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Modificar establecimiento"
            android:layout_marginTop="18dp" />

        <TextView
            android:id="@+id/txtResultadoModificar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Resultado"
            android:textSize="16sp"
            android:textColor="@color/text_black"
            android:layout_marginTop="20dp" />

    </LinearLayout>
</ScrollView>