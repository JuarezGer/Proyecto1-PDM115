<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/mainLayoutMedicamentosWeb"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@color/background_app">

    <Button
        android:id="@+id/btnCargarMedicamentos"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Cargar medicamentos desde servicio web" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="15dp">

        <TextView
            android:id="@+id/txtMedicamentos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Aquí aparecerá el inventario de medicamentos"
            android:textSize="16sp"
            android:textColor="@color/text_black" />

    </ScrollView>

</LinearLayout>